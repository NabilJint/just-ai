# pnpm configuration
node-linker=hoisted

# Explicitly allow builds for packages with native addons and build scripts
onlyBuiltDependencies[]=@clerk/shared
onlyBuiltDependencies[]=@prisma/engines
onlyBuiltDependencies[]=bufferutil
onlyBuiltDependencies[]=core-js
onlyBuiltDependencies[]=esbuild
onlyBuiltDependencies[]=prisma
onlyBuiltDependencies[]=protobufjs
onlyBuiltDependencies[]=sharp
onlyBuiltDependencies[]=unrs-resolver
onlyBuiltDependencies[]=utf-8-validate

# CI-friendly settings
strict-peer-dependencies=false
auto-install-peers=true
shamefully-hoist=true
